# Site profile read by scripts/*.sh (shell-sourceable, no secrets). One file per site.
# Host: Cloudways (SSH on port 22, WP-CLI preinstalled). SSH_HOST = server Public IP; SSH_USER = Master Credentials
# username (master_xxxxx), whose SSH Public Keys list holds the key for these scripts.
# TBD values come from the hosting handoff. Each can be overridden by the matching ETCH_* environment variable,
# so a cloud environment can set them without a commit.
SITE_NAME="DealDirect STAGING"
SITE_URL="${ETCH_SITE_URL:-https://wordpress-1077248-6717515.cloudwaysapps.com}"
SSH_HOST="${ETCH_SSH_HOST:-66.42.75.99}"
SSH_PORT="${ETCH_SSH_PORT:-22}"
SSH_USER="${ETCH_SSH_USER:-master_peedmrgrfq}"
# Private key file. Cloud sessions: scripts/ssh-setup.sh writes it from the ETCH_SSH_KEY secret.
SSH_KEY_FILE="${ETCH_SSH_KEY_FILE:-$HOME/.ssh/dealdirect_staging}"
# BatchMode: never hang on a password/passphrase prompt in an unattended run. Host key must already be in known_hosts.
SSH_CMD="ssh -i $SSH_KEY_FILE -p $SSH_PORT -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=20 $SSH_USER@$SSH_HOST"
# Cloudways master user: applications/<app folder>/public_html (app folder = Application Settings > Folder).
WP_PATH="${ETCH_WP_PATH:-applications/kyvvrceayg/public_html}"
WP_CMD="wp"
# Cache purge after writes. Cloudways: object cache + Breeze page cache (Breeze also purges Varnish when its Varnish option is on).
PURGE_CMD="${ETCH_PURGE_CMD:-wp cache flush; wp breeze purge --cache=all}"
# Options snapshotted by default (Etch storage).
SNAP_OPTIONS="etch_styles etch_global_stylesheets etch_loops"
# Pages/blocks that must never be restored or overwritten without a typed OK from Alex. Fill once header/footer/templates exist.
PROTECTED_IDS=""
# Pinned versions (recorded 2026-10-08 from ssh-setup.sh --check; WP 7.1.3, etch-theme 0.0.3). Re-record on every update.
PIN_ETCH="1.6.8"
PIN_ACSS="4.0.1"
# Etch Asset Manager compression preset applied to images the deploy imports. Empty: the only saved preset.
COMPRESS_PRESET=""
